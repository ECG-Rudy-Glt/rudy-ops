---
import "../styles/global.css";
import Nav from "../components/Nav";
import Footer from "../components/Footer";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, "https://rudy-ops.fr").toString();

const ogImageUrl = new URL("/images/avatar.png", "https://rudy-ops.fr").toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "rudy-ops.fr",
  alternateName: "Rudy Gault, Freelance DevOps, Platform Engineer & DevSecOps Tours",
  description:
    "Freelance DevOps, Platform Engineer et DevSecOps basé à Tours : Infrastructure as Code, infrastructure on-premise, sites web statiques et dynamiques, IA dans les workflows, sécurité.",
  url: "https://rudy-ops.fr",
  taxID: "99992110900016",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Tours",
    addressCountry: "FR",
  },
  areaServed: "Tours, France",
  priceRange: "€€",
  founder: {
    "@type": "Person",
    name: "Rudy Gault",
  },
  sameAs: [
    "https://www.malt.fr/profile/rudygault",
    "https://www.linkedin.com/in/rudy-gault",
    "https://portfolio.gault-rudy.com",
  ],
  knowsAbout: [
    "Freelance DevOps",
    "DevSecOps",
    "Infrastructure as Code",
    "Terraform",
    "Ansible",
    "Kubernetes",
    "Infrastructure on-premise",
    "Sécurité informatique",
  ],
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
      } catch {}
    </script>
  </head>
  <body>
    <div class="page">
      <Nav client:load />
      <slot />
      <Footer />
    </div>
  </body>
</html>
